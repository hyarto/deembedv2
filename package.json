{
  "name": "si-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "PCB / SI 检查工作台：走线、约束、加工能力、扇出、铜皮与综合一体化检查（纯前端）",
  "scripts": {
    "serve": "node serve.js",
    "serve:pcb": "node serve.js --entry=pcb",
    "serve:si": "node serve.js --entry=si",
    "test": "node tools/run-tests.js all",
    "test:engine": "node tools/run-tests.js engine",
    "test:ui": "node tools/run-tests.js ui",
    "test:geometry": "node tools/run-tests.js engine geometry",
    "bench": "node tools/run-tests.js bench"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
